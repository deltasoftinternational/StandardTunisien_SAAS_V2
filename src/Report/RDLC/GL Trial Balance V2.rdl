  <Code>Public Function BlankNegAndZero(ByVal Value As Decimal)
    if Value &lt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZero(ByVal Value As Decimal)
    if Value = 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankPos(ByVal Value As Decimal)
    if Value &gt; 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankZeroAndPos(ByVal Value As Decimal)
    if Value &gt;= 0 then
        Return ""
    end if
    Return Value
End Function

Public Function BlankNeg(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return ""
    end if
    Return Value
End Function

Dim public totalBalance as Decimal
Public Function AddTotal(ByVal balance AS Decimal ) AS Decimal
                totalBalance = totalBalance + balance
                return balance
 
End Function
 
Public Function GetTotal()
                return totalBalance
End Function

Public Function ShowNegAsHyphen(ByVal Value As Decimal)
    if Value &lt; 0 then
        Return "-"
    end if
    Return Value
End Function

Public Function ShowZeroAsHyphen(ByVal Value As Decimal)
    if Value = 0 then
        Return "-"
    end if
    Return Value
End Function</Code>
